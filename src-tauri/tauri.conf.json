{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gale",
  "version": "0.1.0",
  "identifier": "com.whiteruby.gale",
  "build": {
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gale — Free OpenVPN Browser",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
